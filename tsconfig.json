{
  "extends": "./src/tsconfig/config.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "experimentalDecorators": true,
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "outDir": "lib",
    "rootDir": "src",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["src", "test-resources", "./*.config.mjs"]
}
