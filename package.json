{
  "name": "@tsofist/web-buddy",
  "version": "2.0.0-next.18",
  "description": "Configuration basics for Linters, TypeScript, Semantic Release and others",
  "type": "module",
  "author": "Andrew Berdnikov <tsofistgudmen@gmail.com>",
  "license": "LGPL-3.0",
  "homepage": "https://github.com/tsofist/web-buddy/",
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "format": "npm run lint:code -- --fix && npm run lint:style -- --fix",
    "test": "npm run build && npm run lint",
    "lint": "npm run lint:code && npm run lint:style && npm run lint:lock-file",
    "lint:code": "WEB_BUDDY_STRICT=1 eslint . --cache --cache-location .cache/",
    "lint:style": "stylelint **/*.{htm,html,vue,css,scss,sass,pcss,postcss} --cache --cache-location .cache/ --allow-empty-input",
    "lint:lock-file": "lockfile-lint",
    "pkg:publish": "semantic-release --no-ci",
    "pkg:publish-test": "semantic-release --no-ci --dry-run",
    "pkg:clean": "rm -rf dist lib .coverage .cache",
    "pkg:purge": "npm run pkg:clean && rm -rf .npm node_modules",
    "prepare": "husky"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/gitlab": "^13.3.3",
    "@semantic-release/npm": "^13.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@total-typescript/ts-reset": "~0.6.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-decorator-position": "^6.1.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lockfile-lint": "^5.0.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "yaml-eslint-parser": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.12",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {},
  "files": [
    "LICENSE",
    "README.md",
    ".editorconfig",
    "lib",
    "!*.private.*",
    "!*.tmp.*"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "tsofist",
    "eslint",
    "prettier",
    "stylelint",
    "web-config",
    "lint"
  ],
  "release": {
    "extends": "./lib/semantic-release/config.github.js"
  },
  "lockfile-lint": {
    "type": "npm",
    "path": "package-lock.json",
    "allowedHosts": [
      "npm"
    ],
    "validateHttps": true,
    "validateIntegrity": true
  }
}
